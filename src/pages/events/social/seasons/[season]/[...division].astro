---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import Link from '@components/Link.astro';
import LinkPanel from '@components/LinkPanel.astro';
import ScoringMix from '@components/ScoringMix.astro';
import { Temporal } from '@js-temporal/polyfill';
import { formatDateRange, formatDayOfSeason } from '@utils/dates';
import { getEvent, getSeasons, metrixUrl, type EventDetail } from '@utils/metrix';
import { birdiesOrBetter, formatShare, roundsInDivision, seasonStats, statsDivisions, totalScores, type ScoreCounts } from '@utils/season-stats';
import { scoreCategories, scoreCategoryLabels } from '@utils/scores';
import { divisionAnchor, divisionLinks, divisionParam, roundPath, seasonPath } from '@utils/social-paths';

// A season's rounds and stats: for all divisions, or (as /div/a etc.) just one.
export async function getStaticPaths() {
  return getSeasons().flatMap((season) =>
    [undefined, ...statsDivisions].map((division) => ({
      params: { season: season.slug, division: divisionParam(division) },
      props: { season, division },
    }))
  );
}

const { season, division } = Astro.props;
const { title, dateStart, dateEnd, socialDays } = season;

// Seasons come newest first.
const seasons = getSeasons();
const seasonIndex = seasons.findIndex((s) => s.slug === season.slug);
const prevSeason = seasons[seasonIndex + 1];
const nextSeason = seasonIndex > 0 ? seasons[seasonIndex - 1] : undefined;

const subtitle = dateStart
  ? formatDateRange(
      Temporal.PlainDate.from(dateStart),
      dateEnd ? Temporal.PlainDate.from(dateEnd) : undefined
    )
  : undefined;

const allRounds = socialDays
  .filter((day) => day.played)
  .map((day) => getEvent(day.id))
  .filter((round): round is EventDetail => round !== null);
const rounds = division ? roundsInDivision(allRounds, division) : allRounds;
const stats = seasonStats(rounds);

// The rounds table covers every division, whichever one the stats are for.
const allStats = division ? seasonStats(allRounds) : stats;
const roundStats = new Map(allStats.rounds.map((r) => [r.number, r]));

const divisionNav = divisionLinks(statsDivisions, division, (d) => `${seasonPath(season, d)}#stats`);

// A round's page, at the division's results when narrowed to one.
function roundHref(roundNumber: number): string {
  const path = roundPath(season, roundNumber);
  return division ? `${path}#${divisionAnchor(division)}` : path;
}

const regulars = stats.players.filter((p) => p.rounds >= 5).length;

// The next round is the first without scores.
const nextDay = socialDays.find((day) => !day.played);

function dayOfSeason(d: string, format: 'long' | 'short' = 'long'): string {
  return formatDayOfSeason(Temporal.PlainDate.from(d), format);
}

function formatToPar(value: number | null, digits = 0): string {
  if (value === null) return '–';
  const text = value.toFixed(digits);
  if (Number(text) === 0) return 'E';
  return value > 0 ? `+${text}` : text;
}

function birdieRate(counts: ScoreCounts): string {
  return formatShare(birdiesOrBetter(counts), totalScores(counts));
}

// Positions in the best-rounds list, with ties sharing a position.
const bestRoundPositions = stats.bestRounds.map((r, _, all) => {
  const first = all.findIndex((o) => o.toPar === r.toPar && o.raw === r.raw);
  return first + 1;
});

// Heat colours for the stats tables, using mdgc-sd's thresholds.
function toParHeat(value: number | null): string {
  if (value === null) return '';
  if (value <= 0) return 'heat-good-4';
  if (value <= 3) return 'heat-good-2';
  if (value <= 6) return 'heat-warn-2';
  if (value <= 9) return 'heat-bad-2';
  return 'heat-bad-4';
}

// Shade a percentage: one level per threshold reached, from 1 to 4.
function percentHeat(kind: string, count: number, total: number, thresholds: number[]): string {
  if (!total) return '';
  const pct = (100 * count) / total;
  const level = Math.min(4, Math.max(1, thresholds.filter((t) => pct >= t).length));
  return `heat-${kind}-${level}`;
}

function birdieHeat(counts: ScoreCounts): string {
  return percentHeat('good', birdiesOrBetter(counts), totalScores(counts), [8, 16, 24, 32]);
}

const largestField = Math.max(1, ...allStats.rounds.map((r) => r.players));

// Shade a count by its fraction of a maximum, in quarters.
function fractionHeat(value: number, max: number): string {
  const level = Math.min(4, Math.max(1, Math.floor((4 * value) / max)));
  return `heat-neutral-${level}`;
}
---

<Layout title={division ? `${title} - Div ${division}` : title} subtitle={subtitle} backLink={{ href: '/events/social', text: 'Social Days' }}>
  <nav class="prev-next-nav not-prose mt-4" aria-label="Seasons">
    {prevSeason ? (
      <a href={seasonPath(prevSeason, division)} rel="prev">← {prevSeason.title}</a>
    ) : <span />}
    {nextSeason ? (
      <a href={seasonPath(nextSeason, division)} rel="next" class="text-right">{nextSeason.title} →</a>
    ) : <span />}
  </nav>
  <div class="mb-8 mt-6 space-y-12">

    <section>
      <h2 id="rounds" class="section-heading mb-4">Rounds</h2>
      <div class="table-scroll max-w-3xl">
        <table class="data-table compact">
          <thead>
            <tr>
              <th class="text-center"><abbr class="no-underline sm:hidden" title="Round">Rd</abbr><span class="hidden sm:inline">Round</span></th>
              <th class="num">Date</th>
              <th>Course</th>
              <th class="num" title="Players who played, or registered so far">Players</th>
              <th class="num" title="Average score to par across the field, from complete scorecards">Avg +/-</th>
              <th class="num" title="Best score to par">Best +/-</th>
            </tr>
          </thead>
          <tbody>
            {socialDays.map((day) => {
              const isNext = day.id === nextDay?.id;
              const r = roundStats.get(day.number);
              const players = day.players;
              return (
                <tr class={isNext ? 'next-round' : undefined}>
                  <td class="text-center font-bold">{day.number}</td>
                  <td class="num whitespace-nowrap">
                    {(() => {
                      const [weekday, ...rest] = dayOfSeason(day.date, 'short').split(' ');
                      return <><span class="hidden sm:inline">{weekday} </span>{rest.join(' ')}</>;
                    })()}
                  </td>
                  <td>
                    <a href={roundHref(day.number)} class="row-link text-mdgc-blue-dark underline">{day.courseTitle}</a>
                    {isNext && <span class="next-pill">Next</span>}
                  </td>
                  <td class={`num ${day.played && players ? fractionHeat(players, largestField) : ''}`}>
                    {day.played ? players : (
                      <>
                        {players}
                        <span class="block text-xs text-slate-500">registered</span>
                      </>
                    )}
                  </td>
                  {day.played ? (
                    <>
                      <td class={`num ${r ? toParHeat(r.averageToPar) : ''}`}>{r ? formatToPar(r.averageToPar, 1) : ''}</td>
                      <td class="num">{r ? formatToPar(r.bestToPar) : ''}</td>
                    </>
                  ) : (
                    <td colspan="2" class="text-center">
                      <Link class="cta-button compact" href={metrixUrl(day.id)} markerClass="hidden sm:inline">Register</Link>
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    {allStats.roundsPlayed > 0 && (
      <section>
        <h2 id="stats" class="section-heading mb-4">Stats</h2>
        <nav class="pill-nav mb-6" aria-label="Division">
          <span class="pill-nav-label">Division</span>
          {divisionNav.map((link) => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.text}</a>
          ))}
        </nav>
        {stats.roundsPlayed > 0 ? (
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
          <div class="stat-card">
            <div class="stat-label">Rounds played</div>
            <div class="stat-value">{stats.roundsPlayed}</div>
            <div class="stat-detail">of {season.socialDays.length} scheduled</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Player rounds</div>
            <div class="stat-value">{stats.playerRounds.toLocaleString('en-AU')}</div>
            <div class="stat-detail">{stats.averageField?.toFixed(1)} average field</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Players</div>
            <div class="stat-value">{stats.uniquePlayers}</div>
            <div class="stat-detail">{regulars} with 5+ rounds</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Holes scored</div>
            <div class="stat-value">{stats.holesScored.toLocaleString('en-AU')}</div>
            <div class="stat-detail">{birdieRate(stats.scoreCounts)} birdie or better</div>
          </div>
        </div>
        ) : (
          <p class="text-slate-600">No Div {division} rounds yet this season.</p>
        )}
      </section>
    )}

    {stats.roundsPlayed > 0 && (
      <>
        <section>
          <h2 id="scoring" class="section-heading mb-4">Scoring mix</h2>
          <p class="mb-4 text-slate-600">
            Every hole scored{division && ` in Div ${division}`} this season, by score relative to par.
          </p>
          <ScoringMix counts={stats.scoreCounts} />
        </section>

        <section>
          <h2 id="best-rounds" class="section-heading mb-4">Best rounds</h2>
          <p class="mb-4 text-slate-600">
            Lowest scores to par, with raw score as the tiebreaker. Courses differ, so compare with care.
          </p>
          <div class="table-scroll max-w-2xl">
            <table class="data-table compact">
              <thead>
                <tr>
                  <th class="text-center">Pos</th>
                  <th>Player</th>
                  <th class="num">+/-</th>
                  <th class="num">Raw</th>
                  <th class="text-center">Round</th>
                  <th>Course</th>
                </tr>
              </thead>
              <tbody>
                {stats.bestRounds.map((r, i) => (
                  <tr>
                    <td class="text-center text-slate-500">{bestRoundPositions[i]}</td>
                    <td class="font-medium whitespace-nowrap">{r.name}</td>
                    <td class="num font-bold text-slate-800">{formatToPar(r.toPar)}</td>
                    <td class="num text-slate-600">{r.raw}</td>
                    <td class="text-center">
                      <a href={roundHref(r.roundNumber)} class="text-mdgc-blue-dark">{r.roundNumber}</a>
                    </td>
                    <td>{r.courseTitle}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2 id="players" class="section-heading mb-4">Player score summaries</h2>
          {division && (
            <p class="mb-4 text-slate-600">
              Each player's scoring in Div {division} this season, from the rounds they played in it.
            </p>
          )}
          <label class="mb-4 flex items-center gap-2" data-players-filter hidden>
            <span class="font-semibold text-slate-600">Show</span>
            <select class="rounded border border-gray-300 bg-white px-2 py-1">
              <option value="5" selected>5+ rounds</option>
              <option value="3">3+ rounds</option>
              <option value="1">All players</option>
            </select>
            <span class="text-sm text-slate-500" data-players-count></span>
          </label>
          <div class="table-scroll max-w-4xl">
            <table class="data-table compact sticky-first-column sortable" data-players-table>
              <thead>
                <tr>
                  <th data-sort="string">Player</th>
                  {!division && <th class="text-center" data-sort="string" title="Division in their latest round">Div</th>}
                  <th class="num" data-sort="number" data-sort-dir="desc" title={division ? `Metrix rating in their latest Div ${division} round` : 'Metrix rating in their latest round'}>Rating</th>
                  <th class="num" data-sort="number" data-sort-dir="desc">Rounds</th>
                  <th class="num sort-asc" data-sort="number" title="Average score to par">Avg</th>
                  <th class="num" data-sort="number" title="Best score to par">Best</th>
                  {scoreCategories.filter((c) => c !== 'ace' && c !== 'eagle').map((c) => (
                    <th
                      class="num"
                      data-sort="number"
                      data-sort-dir={c === 'birdie' || c === 'par' ? 'desc' : undefined}
                      title={c === 'birdie' ? 'Birdie or better' : c === 'double-plus' ? 'Double bogey or worse' : undefined}
                    >
                      {c === 'birdie' ? '≤ Birdie' : scoreCategoryLabels[c]}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {stats.players.map((p) => {
                  const total = totalScores(p.scoreCounts);
                  const share = (count: number) => (total ? count / total : '');
                  const birdies = birdiesOrBetter(p.scoreCounts);
                  return (
                    <tr data-rounds={p.rounds}>
                      <td class="font-medium whitespace-nowrap">{p.name}</td>
                      {!division && <td class="text-center">{p.division}</td>}
                      <td class="num text-slate-500" data-value={p.rating ?? ''}>{p.rating ?? '–'}</td>
                      <td class={`num ${fractionHeat(p.rounds, stats.roundsPlayed)}`}>{p.rounds}</td>
                      <td class={`num ${toParHeat(p.averageToPar)}`} data-value={p.averageToPar ?? ''}>{formatToPar(p.averageToPar, 1)}</td>
                      <td class={`num ${toParHeat(p.bestToPar)}`} data-value={p.bestToPar ?? ''}>{formatToPar(p.bestToPar)}</td>
                      <td class={`num ${birdieHeat(p.scoreCounts)}`} data-value={share(birdies)}>{formatShare(birdies, total)}</td>
                      <td class={`num ${percentHeat('neutral', p.scoreCounts.par, total, [25, 35, 45, 55])}`} data-value={share(p.scoreCounts.par)}>
                        {formatShare(p.scoreCounts.par, total)}
                      </td>
                      <td class={`num ${percentHeat('warn', p.scoreCounts.bogey, total, [15, 25, 35, 45])}`} data-value={share(p.scoreCounts.bogey)}>
                        {formatShare(p.scoreCounts.bogey, total)}
                      </td>
                      <td class={`num ${percentHeat('bad', p.scoreCounts['double-plus'], total, [3, 7, 11, 15])}`} data-value={share(p.scoreCounts['double-plus'])}>
                        {formatShare(p.scoreCounts['double-plus'], total)}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      </>
    )}

    <Grid>
      <LinkPanel
        image="/images/logos/metrix-favicon.png"
        href={metrixUrl(season.id)}
        title="View on Metrix"
        description="this season on Disc Golf Metrix"
      />
    </Grid>

  </div>
</Layout>

<style>
  .next-round td {
    background: var(--color-amber-50);
  }

  .next-pill {
    margin-left: 0.5rem;
    padding: 0 0.5rem;
    border-radius: 9999px;
    background: var(--color-amber-500);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .heat-neutral-1 { background: #eff8fc; color: #17465f; }
  .heat-neutral-2 { background: #dff1fb; color: #15425c; }
  .heat-neutral-3 { background: #cae8f7; color: #11374c; }
  .heat-neutral-4 { background: #b5dff3; color: #0e2f42; }
  .heat-good-1 { background: #ebf8ef; color: #0f5132; }
  .heat-good-2 { background: #d8f0e5; color: #0b3f38; }
  .heat-good-3 { background: #b7e8cd; color: #07351f; }
  .heat-good-4 { background: #8addae; color: #062f1c; }
  .heat-warn-1 { background: #fff4e5; color: #6e3f00; }
  .heat-warn-2 { background: #ffe1c2; color: #7a3b00; }
  .heat-warn-3 { background: #ffc58e; color: #612900; }
  .heat-warn-4 { background: #ffad66; color: #552100; }
  .heat-bad-1 { background: #fdecea; color: #7a2722; }
  .heat-bad-2 { background: #f8d1cc; color: #8c2c27; }
  .heat-bad-3 { background: #efaaa4; color: #711d1a; }
  .heat-bad-4 { background: #e68079; color: #5f1714; }
</style>

<script>
  import '@src/scripts/sortable-table';

  // Filter the players table by rounds played. Without this script, the
  // control stays hidden and every player is listed.
  const control = document.querySelector<HTMLElement>('[data-players-filter]');
  const select = control?.querySelector('select');
  const count = control?.querySelector('[data-players-count]');
  const rows = document.querySelectorAll<HTMLTableRowElement>('[data-players-table] tbody tr');

  function applyFilter() {
    const min = Number(select?.value ?? 1);
    let shown = 0;
    for (const row of rows) {
      const visible = Number(row.dataset.rounds) >= min;
      row.hidden = !visible;
      if (visible) shown++;
    }
    if (count) count.textContent = `${shown} of ${rows.length} players`;
  }

  if (control && select) {
    control.hidden = false;
    select.addEventListener('change', applyFilter);
    applyFilter();
  }
</script>

