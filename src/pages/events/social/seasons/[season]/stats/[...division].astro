---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import LinkPanel from '@components/LinkPanel.astro';
import ScoringMix from '@components/ScoringMix.astro';
import SeasonNav from '@components/SeasonNav.astro';
import { Temporal } from '@js-temporal/polyfill';
import { formatDateRange } from '@utils/dates';
import { getEvent, getSeasons, metrixUrl, type EventDetail } from '@utils/metrix';
import { birdiesOrBetter, formatShare, roundsInDivision, seasonStats, statsDivisions, totalScores } from '@utils/season-stats';
import { birdieHeat, formatToPar, fractionHeat, percentHeat, toParHeat } from '@utils/season-format';
import { scoreCategories, scoreCategoryLabels } from '@utils/scores';
import { divisionAnchor, divisionLinks, divisionParam, roundPath, seasonStatsPath } from '@utils/social-paths';

// A season's stats: for all divisions, or (as /div/a etc.) just one.
export async function getStaticPaths() {
  return getSeasons().flatMap((season) =>
    [undefined, ...statsDivisions].map((division) => ({
      params: { season: season.slug, division: divisionParam(division) },
      props: { season, division },
    }))
  );
}

const { season, division } = Astro.props;
const { title, dateStart, dateEnd, socialDays } = season;

const subtitle = dateStart
  ? formatDateRange(
      Temporal.PlainDate.from(dateStart),
      dateEnd ? Temporal.PlainDate.from(dateEnd) : undefined
    )
  : undefined;

const allRounds = socialDays
  .filter((day) => day.played)
  .map((day) => getEvent(day.id))
  .filter((round): round is EventDetail => round !== null);
const rounds = division ? roundsInDivision(allRounds, division) : allRounds;
const stats = seasonStats(rounds);

const divisionNav = divisionLinks(statsDivisions, division, (d) => seasonStatsPath(season, d));

// A round's page, at the division's results when narrowed to one.
function roundHref(roundNumber: number): string {
  const path = roundPath(season, roundNumber);
  return division ? `${path}#${divisionAnchor(division)}` : path;
}

// Positions in the best-rounds list, with ties sharing a position.
const bestRoundPositions = stats.bestRounds.map((r, _, all) => {
  const first = all.findIndex((o) => o.toPar === r.toPar && o.raw === r.raw);
  return first + 1;
});
---

<Layout title={division ? `${title} - Div ${division}` : title} subtitle={subtitle} backLink={{ href: '/events/social', text: 'Social Days' }}>
  <SeasonNav season={season} page="stats" division={division} />
  <nav class="pill-nav mt-6" aria-label="Division">
    <span class="pill-nav-label">Division</span>
    {divisionNav.map((link) => (
      <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.text}</a>
    ))}
  </nav>
  <div class="mb-8 mt-6 space-y-12">

    {stats.roundsPlayed === 0 && (
      <p class="text-slate-600">No {division ? `Div ${division} ` : ''}rounds played yet this season.</p>
    )}

    {stats.roundsPlayed > 0 && (
      <>
        <section>
          <h2 id="scoring" class="section-heading mb-4">Scoring mix</h2>
          <p class="mb-4 text-slate-600">
            Every hole scored{division && ` in Div ${division}`} this season, by score relative to par.
          </p>
          <ScoringMix counts={stats.scoreCounts} />
        </section>

        <section>
          <h2 id="best-rounds" class="section-heading mb-4">Best rounds</h2>
          <p class="mb-4 text-slate-600">
            Lowest scores to par, with raw score as the tiebreaker. Courses differ, so compare with care.
          </p>
          <div class="table-scroll max-w-2xl">
            <table class="data-table compact">
              <thead>
                <tr>
                  <th class="text-center">Pos</th>
                  <th>Player</th>
                  <th class="num">+/-</th>
                  <th class="num">Raw</th>
                  <th class="text-center"><abbr class="no-underline sm:hidden" title="Round">Rd</abbr><span class="hidden sm:inline">Round</span></th>
                  <th>Course</th>
                </tr>
              </thead>
              <tbody>
                {stats.bestRounds.map((r, i) => (
                  <tr>
                    <td class="text-center text-slate-500">{bestRoundPositions[i]}</td>
                    <td class="font-medium whitespace-nowrap">{r.name}</td>
                    <td class="num font-bold text-slate-800">{formatToPar(r.toPar)}</td>
                    <td class="num text-slate-600">{r.raw}</td>
                    <td class="text-center">
                      <a href={roundHref(r.roundNumber)} class="text-mdgc-blue-dark">{r.roundNumber}</a>
                    </td>
                    <td>{r.courseTitle}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2 id="players" class="section-heading mb-4">Player score summaries</h2>
          {division && (
            <p class="mb-4 text-slate-600">
              Each player's scoring in Div {division} this season, from the rounds they played in it.
            </p>
          )}
          <label class="mb-4 flex items-center gap-2" data-players-filter hidden>
            <span class="font-semibold text-slate-600">Show</span>
            <select class="rounded border border-gray-300 bg-white px-2 py-1">
              <option value="5" selected>5+ rounds</option>
              <option value="3">3+ rounds</option>
              <option value="1">All players</option>
            </select>
            <span class="text-sm text-slate-500" data-players-count></span>
          </label>
          <div class="table-scroll max-w-4xl">
            <table class="data-table compact sticky-first-column sortable" data-players-table>
              <thead>
                <tr>
                  <th data-sort="string">Player</th>
                  {!division && <th class="text-center" data-sort="string" title="Division in their latest round">Div</th>}
                  <th class="num" data-sort="number" data-sort-dir="desc" title={division ? `Metrix rating in their latest Div ${division} round` : 'Metrix rating in their latest round'}>Rating</th>
                  <th class="num" data-sort="number" data-sort-dir="desc">Rounds</th>
                  <th class="num sort-asc" data-sort="number" title="Average score to par">Avg</th>
                  <th class="num" data-sort="number" title="Best score to par">Best</th>
                  {scoreCategories.filter((c) => c !== 'ace' && c !== 'eagle').map((c) => (
                    <th
                      class="num"
                      data-sort="number"
                      data-sort-dir={c === 'birdie' || c === 'par' ? 'desc' : undefined}
                      title={c === 'birdie' ? 'Birdie or better' : c === 'double-plus' ? 'Double bogey or worse' : undefined}
                    >
                      {c === 'birdie' ? '≤ Birdie' : scoreCategoryLabels[c]}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {stats.players.map((p) => {
                  const total = totalScores(p.scoreCounts);
                  const share = (count: number) => (total ? count / total : '');
                  const birdies = birdiesOrBetter(p.scoreCounts);
                  return (
                    <tr data-rounds={p.rounds}>
                      <td class="font-medium whitespace-nowrap">{p.name}</td>
                      {!division && <td class="text-center">{p.division}</td>}
                      <td class="num text-slate-500" data-value={p.rating ?? ''}>{p.rating ?? '–'}</td>
                      <td class={`num ${fractionHeat(p.rounds, stats.roundsPlayed)}`}>{p.rounds}</td>
                      <td class={`num ${toParHeat(p.averageToPar)}`} data-value={p.averageToPar ?? ''}>{formatToPar(p.averageToPar, 1)}</td>
                      <td class={`num ${toParHeat(p.bestToPar)}`} data-value={p.bestToPar ?? ''}>{formatToPar(p.bestToPar)}</td>
                      <td class={`num ${birdieHeat(p.scoreCounts)}`} data-value={share(birdies)}>{formatShare(birdies, total)}</td>
                      <td class={`num ${percentHeat('neutral', p.scoreCounts.par, total, [25, 35, 45, 55])}`} data-value={share(p.scoreCounts.par)}>
                        {formatShare(p.scoreCounts.par, total)}
                      </td>
                      <td class={`num ${percentHeat('warn', p.scoreCounts.bogey, total, [15, 25, 35, 45])}`} data-value={share(p.scoreCounts.bogey)}>
                        {formatShare(p.scoreCounts.bogey, total)}
                      </td>
                      <td class={`num ${percentHeat('bad', p.scoreCounts['double-plus'], total, [3, 7, 11, 15])}`} data-value={share(p.scoreCounts['double-plus'])}>
                        {formatShare(p.scoreCounts['double-plus'], total)}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      </>
    )}

    <Grid>
      <LinkPanel
        image="/images/logos/metrix-favicon.png"
        href={metrixUrl(season.id)}
        title="View on Metrix"
        description="this season on Disc Golf Metrix"
      />
    </Grid>

  </div>
</Layout>


<script>
  import '@src/scripts/sortable-table';

  // Filter the players table by rounds played. Without this script, the
  // control stays hidden and every player is listed.
  const control = document.querySelector<HTMLElement>('[data-players-filter]');
  const select = control?.querySelector('select');
  const count = control?.querySelector('[data-players-count]');
  const rows = document.querySelectorAll<HTMLTableRowElement>('[data-players-table] tbody tr');

  function applyFilter() {
    const min = Number(select?.value ?? 1);
    let shown = 0;
    for (const row of rows) {
      const visible = Number(row.dataset.rounds) >= min;
      row.hidden = !visible;
      if (visible) shown++;
    }
    if (count) count.textContent = `${shown} of ${rows.length} players`;
  }

  if (control && select) {
    control.hidden = false;
    select.addEventListener('change', applyFilter);
    applyFilter();
  }
</script>

