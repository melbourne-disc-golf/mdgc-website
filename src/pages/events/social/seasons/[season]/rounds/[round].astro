---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import LinkPanel from '@components/LinkPanel.astro';
import { getSocialPrizeNotes, getSocialPrizeWinners } from '@data/social-prize-winners';
import { Temporal } from '@js-temporal/polyfill';
import { formatDateRange } from '@utils/dates';
import { getEvent, getUpcomingSocialDay, getSeasons } from '@utils/metrix';
import { seasonPath } from '@utils/social-paths';

export async function getStaticPaths() {
  return getSeasons().flatMap((season) =>
    season.socialDays.map((day) => ({
      params: { season: season.slug, round: String(day.number) },
      props: { season, eventId: day.id },
    }))
  );
}

const { season, eventId } = Astro.props;

// A social day shows its groups (the draw) while it's still upcoming, and its
// results once played — the two are independent, so a social day on the day
// can show both.
const results = getEvent(eventId);
const upcoming = getUpcomingSocialDay(eventId);
const detail = results ?? upcoming;
if (!detail) {
  throw new Error(`No Metrix data for social day ${eventId}`);
}

const { name, date } = detail;
const subtitle = formatDateRange(Temporal.PlainDate.from(date));

const today = Temporal.Now.plainDateISO().toString();
const showGroups = date >= today;

// Back-link up to this social day's season.
const backLink = {
  href: seasonPath(season),
  text: season.name,
};

const { par, tracks, divisions } = results ?? { par: 0, tracks: [], divisions: [] };
const prizeWinners = results ? getSocialPrizeWinners(results.id) : [];
const prizeNotes = results ? getSocialPrizeNotes(results.id) : [];

// Shade a hole score's background relative to its par (disc-golf scorecard colours).
function holeClass(score: number | null, holePar: number): string {
  if (score === null) return 'text-slate-300';
  if (score === 1) return 'bg-[#ffd60a] text-[#3f2600]';       // ace
  const diff = score - holePar;
  if (diff <= -2) return 'bg-[#55d57d] text-[#06351f]';        // eagle or better
  if (diff === -1) return 'bg-[#d8f0e5] text-[#0b3f38]';       // birdie
  if (diff === 0) return 'text-slate-700';                      // par
  if (diff === 1) return 'bg-[#ffe1c2] text-[#7a3b00]';        // bogey
  return 'bg-[#f8e7e4] text-[#8c2c27]';                        // double bogey or worse
}

function formatDiff(diff: number): string {
  return diff > 0 ? `+${diff}` : String(diff);
}

function fmt2(n: number | null): string {
  return n === null ? '–' : n.toFixed(2);
}
---

<Layout title={name} subtitle={subtitle} backLink={backLink}>
  <div class="my-8 space-y-10">

    {showGroups && upcoming && (
      <section class="space-y-4">
        <h2 class="section-heading">Registered players</h2>
        <p class="text-slate-600">
          {upcoming.registeredCount === 0
            ? 'No players have registered yet.'
            : `${upcoming.registeredCount} player${upcoming.registeredCount === 1 ? '' : 's'} registered.`}
        </p>

        {upcoming.groups.length > 0 && (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.groups.map((g) => (
              <div class="overflow-hidden rounded-lg border border-slate-200">
                <h3 class="px-3 py-2 text-sm font-bold text-white bg-linear-to-r from-mdgc-blue-dark to-mdgc-blue">Group {g.name}</h3>
                <ul class="divide-y divide-slate-100">
                  {g.players.length === 0 ? (
                    <li class="px-3 py-1.5 text-sm text-slate-400 italic">empty</li>
                  ) : g.players.map((p) => (
                    <li class="flex items-baseline justify-between gap-3 px-3 py-1.5 text-sm">
                      <span>{p.name}</span>
                      <span class="text-xs text-slate-500 whitespace-nowrap">Div {p.division}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    {prizeWinners.length > 0 && (
      <section>
        <h2 class="section-heading mb-4">Prize winners</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {prizeWinners.map((winner) => (
            <li class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3">
              <p class="text-sm font-semibold text-emerald-900">{winner.prize}</p>
              <p class="mt-1 text-lg font-bold text-slate-900">{winner.name}</p>
              <p class="mt-0.5 text-sm text-slate-600">{winner.detail}</p>
            </li>
          ))}
        </ul>
        {prizeNotes.map((note) => (
          <p class="mt-3 text-sm text-slate-600">{note}</p>
        ))}
      </section>
    )}

    {results && divisions.map((division) => {
      return (
      <section>
        <h2 class="section-heading mb-4">{division.name}</h2>
        <div class="table-scroll">
          <table class="data-table compact sticky-first-two-columns">
            <thead>
              <tr>
                <th class="text-center">Pos</th>
                <th>Player</th>
                <th class="num" title="Metrix rating">Rating</th>
                <th class="num" title="Handicap score">HC</th>
                <th class="num">+/-</th>
                <th class="num" title="Raw score">Raw</th>
                {tracks.map((t) => (
                  <th class="num" title={`Par ${t.par}`}>{t.number}</th>
                ))}
              </tr>
              <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th class="num">Par</th>
                <th class="num">{par}</th>
                {tracks.map((t) => (
                  <th class="num">{t.par}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {division.players.map((p) => (
                <tr>
                  <td class="text-center">
                    {p.pos <= 3 ? (
                      <span class={`podium-badge podium-${p.pos}`}>{p.pos}</span>
                    ) : (
                      <span class="text-slate-500">{p.pos}</span>
                    )}
                  </td>
                  <td class="font-medium whitespace-nowrap">{p.name}</td>
                  <td class="num text-slate-500">{p.rating ?? '–'}</td>
                  <td class="num text-slate-600">{fmt2(p.net)}</td>
                  <td class="num font-bold text-slate-800">{formatDiff(p.diff)}</td>
                  <td class="num text-slate-600">{p.sum}</td>
                  {p.holes.map((score, h) => (
                    <td class={`num ${holeClass(score, tracks[h]?.par ?? par)}`}>{score ?? '–'}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
      );
    })}

    <Grid>
      <LinkPanel
        image="/images/logos/metrix-favicon.png"
        href={`https://discgolfmetrix.com/${detail.id}`}
        title="View on Metrix"
        description={results ? 'this social day on Disc Golf Metrix' : 'register for this social day on Disc Golf Metrix'}
      />
    </Grid>

  </div>
</Layout>

<style>
  /* Gold / silver / bronze position badges. */
  .podium-badge {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    color: #152018;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.75), 0 2px 5px rgba(31, 54, 44, 0.18);
  }
  .podium-1 { background: linear-gradient(145deg, #fff4ba, #e2a51d); }
  .podium-2 { background: linear-gradient(145deg, #ffffff, #aeb9c2); }
  .podium-3 { background: linear-gradient(145deg, #ffd9aa, #b36b27); color: #271606; }
</style>
