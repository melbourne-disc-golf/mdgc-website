---
import Layout from '@layouts/Layout.astro';
import Grid from '@components/Grid.astro';
import LinkPanel from '@components/LinkPanel.astro';
import CourseCard from '@components/CourseCard.astro';
import { getEntry } from 'astro:content';
import { getSocialPrizeNotes, getSocialPrizeWinners } from '@data/social-prize-winners';
import { Temporal } from '@js-temporal/polyfill';
import { formatDayOfSeason } from '@utils/dates';
import { getEvent, getUpcomingSocialDay, getSeasons, metrixUrl } from '@utils/metrix';
import { ctbAnchor, ctbLabel, ctbToday } from '@utils/ctb';
import { scoreCategory } from '@utils/scores';
import Link from '@components/Link.astro';
import { externalUrls } from '@data/external-urls';
import { divisionAnchor, roundPath, seasonPath } from '@utils/social-paths';

export async function getStaticPaths() {
  return getSeasons().flatMap((season) =>
    season.socialDays.map((day) => ({
      params: { season: season.slug, round: String(day.number) },
      props: { season, eventId: day.id },
    }))
  );
}

const { season, eventId } = Astro.props;

// A social day shows its groups (the draw) while it's still upcoming, and its
// results once played — the two are independent, so a social day on the day
// can show both.
const results = getEvent(eventId);
const upcoming = getUpcomingSocialDay(eventId);
const detail = results ?? upcoming;
if (!detail) {
  throw new Error(`No Metrix data for social day ${eventId}`);
}

const { title, date } = detail;
const plainDate = Temporal.PlainDate.from(date);
const subtitle = `${formatDayOfSeason(plainDate)}, ${plainDate.year}`;
const course = detail.courseSlug ? await getEntry('courses', detail.courseSlug) : undefined;

// Details Metrix doesn't hold, if this social day has an entry.
const extras = await getEntry('socialDays', String(eventId));
const coordinators = extras?.data.coordinators ?? [];
const ctbPrizes = (extras?.data.ctb ?? []).filter((prize) => prize.hole !== undefined);
// CTB claims count only on the day; the section stays up all that day, even once results are in.
const ctbDay = date === ctbToday();
const cmsPath = extras ? `/collections/social-days/entries/${extras.id}` : undefined;

const today = Temporal.Now.plainDateISO().toString();
const showGroups = date >= today;

// Back-link up to this social day's season.
const backLink = {
  href: seasonPath(season),
  text: season.title,
};

const rounds = [...season.socialDays].sort((a, b) => a.number - b.number);
const roundIndex = rounds.findIndex((day) => day.id === eventId);
const prevRound = rounds[roundIndex - 1];
const nextRound = rounds[roundIndex + 1];

const { par, tracks, divisions } = results ?? { par: 0, tracks: [], divisions: [] };
const prizeWinners = results ? getSocialPrizeWinners(results.id) : [];
const prizeNotes = results ? getSocialPrizeNotes(results.id) : [];

function holeClass(score: number | null, holePar: number): string {
  return score === null ? 'text-slate-300' : `score-${scoreCategory(score, holePar)}`;
}

function formatDiff(diff: number): string {
  return diff > 0 ? `+${diff}` : String(diff);
}

function fmt2(n: number | null): string {
  return n === null ? '–' : n.toFixed(2);
}
---

<Layout title={title} subtitle={subtitle} backLink={backLink} cmsPath={cmsPath}>
  <nav class="prev-next-nav not-prose mt-4" aria-label="Rounds in this season">
    {prevRound ? (
      <a href={roundPath(season, prevRound.number)} rel="prev">
        ← Round {prevRound.number}
      </a>
    ) : <span />}
    {nextRound ? (
      <a href={roundPath(season, nextRound.number)} rel="next" class="text-right">
        Round {nextRound.number} →
      </a>
    ) : <span />}
  </nav>

  <div class="my-8 space-y-10">

    {!results && course && (
      <Grid>
        <CourseCard
          name={course.data.title}
          href={`/courses/${course.id}`}
          location={course.data.suburb}
          image={course.data.thumbnail || course.data.mainImage}
        />
      </Grid>
    )}

    {!results && (
      <div class="social-callout flex flex-wrap items-center justify-between gap-4">
        <p>
          Pre-registration is required.{' '}
          {upcoming?.registeredCount
            ? <><strong>{upcoming.registeredCount} player{upcoming.registeredCount === 1 ? '' : 's'} registered</strong> so far.</>
            : 'No one has registered yet.'}
        </p>
        <Link class="cta-button" href={metrixUrl(detail.id)}>Register on Metrix</Link>
      </div>
    )}

    {coordinators.length > 0 && (
      <p>
        <strong>{coordinators.length === 1 ? 'Coordinator' : 'Coordinators'}:</strong> {coordinators.join(', ')}
      </p>
    )}

    {showGroups && upcoming && upcoming.registeredCount > 0 && (
      <section class="space-y-4">
        <h2 class="section-heading">Registered players</h2>

        {upcoming.groups.length > 0 && (
          <p class="text-slate-600">
            Groups are split between 8:00am and 10:30am starts. Check your tee time on <Link class="text-mdgc-blue underline" href={metrixUrl(upcoming.id)}>Disc Golf Metrix</Link>.
          </p>
        )}

        {upcoming.groups.length > 0 && (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.groups.map((g) => (
              <div class="overflow-hidden rounded-lg border border-slate-200">
                <h3 class="px-3 py-2 text-sm font-bold text-white bg-linear-to-r from-mdgc-blue-dark to-mdgc-blue">Group {g.name}</h3>
                <ul class="divide-y divide-slate-100">
                  {g.players.length === 0 ? (
                    <li class="px-3 py-1.5 text-sm text-slate-400 italic">empty</li>
                  ) : g.players.map((p) => (
                    <li class="flex items-baseline justify-between gap-3 px-3 py-1.5 text-sm">
                      <span>{p.name}</span>
                      <span class="text-xs text-slate-500 whitespace-nowrap">Div {p.division}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    {(!results || ctbDay) && (
      <section class="space-y-4">
        <h2 id="ctb" class="section-heading">CTB holes</h2>
        <p class="text-slate-600">There's a closest-to-the-basket (CTB) prize for each group of divisions.</p>
        <p class="text-slate-600">
          {ctbPrizes.length === 0
            ? "This round's CTB holes haven't been set yet; the coordinator usually chooses them the day before."
            : 'If your throw beats the current CTB, move the flag to where it landed (the front of the disc), then record it below.'}
        </p>

        {ctbPrizes.length > 0 && (
          <>
            <p class="social-callout">
              <strong>Prototype.</strong> These forms aren't live yet; submitting them doesn't record anything.
              For now, record your CTB on the <Link class="text-mdgc-blue underline" href={externalUrls.ctb}>CTB Google Form</Link>.
            </p>
            <div class="grid gap-4 sm:grid-cols-2">
              {ctbPrizes.map((prize) => (
                <form id={ctbAnchor(prize)} class="scroll-mt-24 space-y-4 rounded-lg border border-slate-200 bg-white p-4" method="get" action={`#${ctbAnchor(prize)}`}>
                  <div>
                    <h3 class="text-xl font-bold">Hole {prize.hole}</h3>
                    <p class="text-sm text-slate-600">{ctbLabel(prize)}</p>
                  </div>
                  <input type="hidden" name="metrixId" value={eventId} />
                  <input type="hidden" name="prize" value={prize.divisions.join('')} />
                  <label class="block space-y-1">
                    <span class="block text-sm font-semibold">Name</span>
                    <input type="text" name="name" required autocomplete="name"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2" />
                  </label>
                  <div class="flex flex-wrap items-center gap-3">
                    <button type="submit" class="cta-button" disabled={!ctbDay}>Record my CTB</button>
                    {!ctbDay && <span class="text-sm text-slate-500">Opens on the day</span>}
                  </div>
                </form>
              ))}
            </div>
          </>
        )}
      </section>
    )}

    {prizeWinners.length > 0 && (
      <section>
        <h2 class="section-heading mb-4">Prize winners</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {prizeWinners.map((winner) => (
            <li class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3">
              <p class="text-sm font-semibold text-emerald-900">{winner.prize}</p>
              <p class="mt-1 text-lg font-bold text-slate-900">{winner.name}</p>
              <p class="mt-0.5 text-sm text-slate-600">{winner.detail}</p>
            </li>
          ))}
        </ul>
        {prizeNotes.map((note) => (
          <p class="mt-3 text-sm text-slate-600">{note}</p>
        ))}
      </section>
    )}

    {results && divisions.map((division) => {
      const nets = division.players.map((p) => p.net).filter((n): n is number => n !== null);
      const bestNet = nets.length ? Math.min(...nets) : null;
      return (
      <section>
        <h2 id={divisionAnchor(division.letter)} class="section-heading mb-4">
          {division.label}
          {division.description && <span class="section-subtitle">{division.description}</span>}
        </h2>
        <div class="table-scroll">
          <table class="data-table compact sticky-first-two-columns">
            <thead>
              <tr>
                <th class="text-center">Pos</th>
                <th>Player</th>
                <th class="num" title="Metrix rating">Rating</th>
                <th class="num" title="Handicap score">HC</th>
                <th class="num">+/-</th>
                <th class="num" title="Raw score">Raw</th>
                {tracks.map((t) => (
                  <th class="num" title={`Par ${t.par}`}>{t.number}</th>
                ))}
              </tr>
              <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th class="num">Par</th>
                <th class="num">{par}</th>
                {tracks.map((t) => (
                  <th class="num">{t.par}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {division.players.map((p) => (
                <tr>
                  <td class="text-center text-slate-500">{p.pos}</td>
                  <td class="font-medium whitespace-nowrap">{p.name}</td>
                  <td class="num text-slate-500">{p.rating ?? '–'}</td>
                  <td class="num text-slate-600">
                    {p.net !== null && p.net === bestNet ? (
                      <span class="gold-pill" title="Best handicap score in this division">{fmt2(p.net)}</span>
                    ) : fmt2(p.net)}
                  </td>
                  <td class="num font-bold text-slate-800">{formatDiff(p.diff)}</td>
                  <td class="num text-slate-600">{p.sum}</td>
                  {p.holes.map((score, h) => (
                    <td class={`num ${holeClass(score, tracks[h]?.par ?? par)}`}>{score ?? '–'}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
      );
    })}

    <Grid>
      <LinkPanel
        image="/images/logos/metrix-favicon.png"
        href={metrixUrl(detail.id)}
        title="View on Metrix"
        description="this social day on Disc Golf Metrix"
      />
    </Grid>

  </div>
</Layout>

<style>
  /* The best handicap score in a division. */
  .gold-pill {
    display: inline-block;
    /* The negative margin keeps the digits in line with the rest of the column. */
    padding: 0 0.375rem;
    margin: 0 -0.375rem;
    border-radius: 999px;
    background: linear-gradient(145deg, #fff4ba, #e2a51d);
    color: #152018;
    font-weight: 700;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.75), 0 2px 5px rgba(31, 54, 44, 0.18);
  }
</style>
