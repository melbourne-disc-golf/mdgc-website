---
// Every hole scored, by score relative to par: a to-scale bar, then a pill per
// category with its count and share.
import { formatShare, totalScores, type ScoreCounts } from '@utils/season-stats';
import { scoreCategories, scoreCategoryLabels } from '@utils/scores';

interface Props {
  counts: ScoreCounts;
}

const { counts } = Astro.props;
const total = totalScores(counts);
---

<div class="score-bar mb-3" aria-hidden="true">
  {scoreCategories.filter((c) => counts[c] > 0).map((c) => (
    <div
      class={`score-${c}`}
      style={`width: ${(100 * counts[c]) / total}%`}
      title={`${scoreCategoryLabels[c]}: ${formatShare(counts[c], total)}`}
    />
  ))}
</div>
<ul class="flex flex-wrap gap-2">
  {scoreCategories.map((c) => (
    <li class={`score-pill score-${c}`}>
      <strong>{c === 'double-plus' ? scoreCategoryLabels[c] : `${scoreCategoryLabels[c]}s`}</strong>
      <span>{counts[c].toLocaleString('en-AU')}</span>
      <span class="opacity-75">{formatShare(counts[c], total)}</span>
    </li>
  ))}
</ul>

<style>
  .score-bar {
    display: flex;
    height: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
    border-radius: 9999px;
    background: white;
  }

  .score-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .score-pill.score-par {
    background: white;
  }
</style>
