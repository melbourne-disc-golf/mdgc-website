---
import { seasonPath, statsPath } from '@utils/social-paths';

interface Props {
  season: { slug: string };
  current: 'events' | 'stats';
}

const { season, current } = Astro.props;
const tabs = [
  { key: 'events', href: seasonPath(season), text: 'Events' },
  { key: 'stats', href: statsPath(season), text: 'Stats' },
];
---

<nav class="page-tabs mt-6" aria-label="Season">
  {tabs.map((tab) => (
    <a href={tab.href} aria-current={tab.key === current ? 'page' : undefined}>{tab.text}</a>
  ))}
</nav>
