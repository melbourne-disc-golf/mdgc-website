---
import { Temporal } from '@js-temporal/polyfill';
import { getSocialDays } from '@utils/metrix';

// Get future events, sorted by date
const today = Temporal.Now.plainDateISO().toString();
const events = getSocialDays()
  .filter(e => e.date > today)
  .sort((a, b) => a.date.localeCompare(b.date));

const WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

// Format date for display
function formatDate(dateStr: string): string {
  const date = Temporal.PlainDate.from(dateStr);
  return `${WEEKDAYS[date.dayOfWeek - 1]}, ${date.day} ${MONTHS[date.month - 1]}`;
}
---

<div class="next-social-day">
  {events.map(event => (
    <div class="social-callout social-day-item hidden" data-date={event.date}>
      <p>
        Our <strong><a href={`https://discgolfmetrix.com/${event.id}`}>next social day</a></strong> is at
        {event.courseSlug ? (
          <a href={`/courses/${event.courseSlug}/`}>{event.courseTitle}</a>
        ) : (
          event.courseTitle
        )}
        on <strong>{formatDate(event.date)}</strong>.
      </p>
    </div>
  ))}
</div>

<style>
  .hidden {
    display: none;
  }
</style>

<script>
  const container = document.querySelector('.next-social-day');
  if (container) {
    const items = container.querySelectorAll('.social-day-item');
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    for (const item of items) {
      const dateStr = (item as HTMLElement).dataset.date;
      if (dateStr) {
        const eventDate = new Date(dateStr);
        if (eventDate > now) {
          item.classList.remove('hidden');
          break; // Only show the first future event
        }
      }
    }
  }
</script>
