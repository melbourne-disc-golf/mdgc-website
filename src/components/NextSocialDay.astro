---
import { Temporal } from '@js-temporal/polyfill';
import { formatDayOfSeason } from '@utils/dates';
import { getSeasons, metrixUrl } from '@utils/metrix';
import Link from '@components/Link.astro';
import { roundPath } from '@utils/social-paths';

// Get future events, sorted by date
const today = Temporal.Now.plainDateISO().toString();
const events = getSeasons()
  .flatMap((season) => season.socialDays.map((day) => ({ ...day, href: roundPath(season, day.number) })))
  .filter(e => e.date > today)
  .sort((a, b) => a.date.localeCompare(b.date));
---

<div class="next-social-day">
  {events.map(event => (
    <div class="social-callout social-day-item hidden flex flex-wrap items-center justify-between gap-4" data-date={event.date}>
      <p>
        Our <strong><a href={event.href}>next social day</a></strong> is at
        {event.courseSlug ? (
          <a href={`/courses/${event.courseSlug}/`}>{event.courseTitle}</a>
        ) : (
          event.courseTitle
        )}
        on <strong>{formatDayOfSeason(Temporal.PlainDate.from(event.date))}</strong>.
      </p>
      <Link class="cta-button" href={metrixUrl(event.id)}>Register on Metrix</Link>
    </div>
  ))}
</div>

<style>
  .hidden {
    display: none;
  }
</style>

<script>
  const container = document.querySelector('.next-social-day');
  if (container) {
    const items = container.querySelectorAll('.social-day-item');
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    for (const item of items) {
      const dateStr = (item as HTMLElement).dataset.date;
      if (dateStr) {
        const eventDate = new Date(dateStr);
        if (eventDate > now) {
          item.classList.remove('hidden');
          break; // Only show the first future event
        }
      }
    }
  }
</script>
